# Copy to .env locally (do not commit secrets). Vite reads VITE_* in the browser.

# --- Vite client → production lobby (required when the web app is not served from the same origin as the API) ---
# Example: https://pof-lobby-production.up.railway.app  (no trailing slash)
VITE_LOBBY_SERVER_URL=

# Optional: override default public lobby used when this env is unset and the site is not on localhost
# VITE_LOBBY_SERVER_FALLBACK_URL=https://api.pantsonfire.app

# Production website (www.pantsonfire.app): join lobbies + shop; no local/host create on web.
# VITE_WEB_JOIN_ONLY=true
# VITE_BILLING_SIMULATE=true  # E2E only — uses POST /api/billing/simulate-purchase
# VITE_PLAY_STORE_URL=
# VITE_APP_STORE_URL=

# Stripe (lobby server — web Checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_TIER_LOCAL_LIAR=price_...
# STRIPE_PRICE_TIER_SUSPECT=price_...
# STRIPE_PRICE_TIER_HOST_MOST=price_...
# STRIPE_PRICE_ADDON_TWIST_TRUTH=price_...
# STRIPE_PRICE_DLC_PACK=price_...
# STRIPE_CATALOG_JSON={"tier:suspect":"price_..."}
# POF_BILLING_SIMULATE=1  # enables simulate + dev entitlements read (never in production)

# --- PoF cloud auth (lobby server — preferred; no Supabase required) ---
# Railway Postgres plugin sets DATABASE_URL on the lobby service.
DATABASE_URL=
POF_AUTH_JWT_SECRET=

# Optional legacy Supabase (only if old clients still use Supabase JWTs)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Lobby server (same machine as `npm run lobby:server`) ---

# Authorization: Bearer <this value> on POST /api/billing/revenuecat
REVENUECAT_WEBHOOK_SECRET=

# Optional JSON map RevenueCat entitlement id -> tier id (fibber|local_liar|suspect|host_most)
# REVENUECAT_ENTITLEMENT_TIER_JSON={"my_rc_entitlement":"host_most"}

# --- Expo native shell (`expo run:ios` / `expo run:android`) ---
EXPO_PUBLIC_GAME_URL=http://localhost:5173
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
