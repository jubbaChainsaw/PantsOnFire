{
  "expo": {
    "name": "Pants on Fire! Find the Liar",
    "slug": "pants-on-fire-find-the-liar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pantsonfire",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#120038"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Online lobby voice chat uses your microphone while you are in a live game."
      }
    },
    "android": {
      "package": "app.pantsonfire.findtheliar",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#120038"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
