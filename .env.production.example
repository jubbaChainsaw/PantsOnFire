# Public lobby server URL used by frontend at build time.
# This MUST be an https:// URL in production.
VITE_LOBBY_SERVER_URL=https://your-lobby-server.example.com

# Optional: mobile shell can also use this same URL for webview target.
# EXPO_PUBLIC_GAME_URL=https://your-web-frontend.example.com

# Lobby server (Railway backend) runtime env vars:
# LOBBY_CLIENT_ORIGINS=https://pantsonfire.app,https://www.pantsonfire.app
# LOBBY_REDIS_URL=redis://your-redis-host:6379
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
