{
  "name": "pants-on-fire-find-the-liar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node server/lobbyServer.js",
    "dev": "vite",
    "lobby:server": "node server/lobbyServer.js",
    "build": "vite build",
    "build:mobile": "POF_MOBILE_BUILD=1 vite build && node scripts/slim-dist-for-mobile.cjs && node scripts/convert-dist-images-webp.cjs && node scripts/patch-dist-for-file-webview.cjs",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "media:validate-videos": "node scripts/validateVideoAssets.cjs",
    "media:validate": "node scripts/validateVideoAssets.cjs",
    "validate:videos": "node scripts/validateVideoAssets.cjs",
    "dlc:sync-picture-manifests": "node scripts/syncPictureDlcManifests.cjs",
    "dlc:lint-picture-manifests": "node scripts/lintPictureDlcManifests.cjs",
    "dlc:new-picture-pack": "node scripts/newPictureDlcPack.cjs",
    "dlc:populate-picture-images": "node scripts/populateAllPicturePromptImages.cjs",
    "dlc:import-picture-pack": "node scripts/importPicturePackFromRoyaltyFree.cjs",
    "dlc:generate-persona-roster": "node scripts/generateDlcPersonaRoster.mjs",
    "expo:start": "expo start",
    "expo:android": "expo run:android",
    "android:bundle-web": "npm run build:mobile && node scripts/copy-web-to-android-assets.cjs",
    "android:apk": "node scripts/generate-expo-branding.cjs && npm run android:bundle-web && EXPO_PUBLIC_USE_BUNDLED_WEB=1 npx expo prebuild --platform android --clean && node scripts/patch-rn-webview-asset-loader.cjs && node scripts/patch-rn-webview-dlc.cjs && node scripts/patch-android-native.cjs && npm run android:bundle-web && cd android && EXPO_PUBLIC_USE_BUNDLED_WEB=1 ./gradlew assembleRelease",
    "android:verify-apk": "node scripts/verify-android-apk.cjs",
    "android:verify-web-bundle": "node scripts/verify-mobile-web-bundle.cjs",
    "audit:graphics": "node scripts/audit-missing-graphics.cjs",
    "content-packs:build": "node scripts/build-content-packs.cjs",
    "expo:ios": "expo run:ios",
    "expo:web": "expo start --web",
    "host:export-default-ssml": "node scripts/exportDefaultHostSsmlCsv.cjs",
    "host:export-voice-master": "node scripts/exportHostVoiceMasterCsv.cjs",
    "host:export-persona-callouts": "node scripts/exportHostPersonaCallouts.mjs",
    "host:export-dlc-voice": "node scripts/exportDlcHostVoicePack.cjs",
    "host:generate-elevenlabs": "node scripts/generateHostVoiceElevenLabs.cjs",
    "host:install-default-voice-pack": "node scripts/installDefaultHostVoicePack.cjs",
    "host:install-theme-host-packs": "node scripts/installThemeHostPacks.cjs",
    "host:install-mapped-videos": "node scripts/installMappedHostVideos.cjs",
    "host:sync-generated-media": "node scripts/syncGeneratedHostMediaFromDisk.cjs",
    "export:default-host-ssml": "node scripts/exportDefaultHostSsmlCsv.cjs",
    "persona:generate-look-overrides": "node scripts/generateLaunchThemeLookOverrides.mjs",
    "persona:export-avatar-prompts": "node scripts/exportPersonaAvatarPrompts.cjs",
    "persona:generate-avatars": "npm run persona:export-avatar-prompts && node scripts/generatePersonaAvatars.cjs --provider fal --model fal-ai/wan/v2.7/edit --size 512x512",
    "persona:key-chroma": "node scripts/chromaKeyPersonaPngs.cjs",
    "picture:generate-parody-rounds": "node scripts/generateParodyPictureRounds.cjs",
    "picture:generate-animal-set": "node scripts/generateAnimalPictureSet.cjs",
    "host:generate-openai-theme-stills": "node scripts/generateOpenAiThemeHostImages.cjs",
    "host:generate-openai-theme-stills:defaults": "node scripts/generateOpenAiThemeHostImages.cjs --face ./public/assets/host-generation/host-face.png --style ./public/assets/host-generation/host-default-key-art.png"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.6",
    "expo": "^55.0.17",
    "expo-file-system": "^58.0.12",
    "expo-splash-screen": "^0.30.10",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "framer-motion": "^11.3.19",
    "livekit-client": "^2.18.8",
    "livekit-server-sdk": "^2.15.2",
    "lucide-react": "^0.453.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "0.83.10",
    "react-native-purchases": "^8.6.2",
    "react-native-webview": "^13.16.1",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
