{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Category Prompt Pack JS export shape",
  "type": "object",
  "required": ["id", "name", "emoji", "prompts"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "emoji": { "type": "string" },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hint", "main", "imposter"],
        "properties": {
          "hint": { "type": "string" },
          "main": { "type": "string" },
          "imposter": { "type": "string" },
          "adultOnly": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
