# Production environment variables for Pants on Fire.
# Copy the relevant sections into your hosting provider's env config.
# NEVER commit real secrets to the repository.

# ══════════════════════════════════════════════════════════════════
# Frontend (Vite build-time — set where the web app is built)
# ══════════════════════════════════════════════════════════════════

# REQUIRED in production. Public lobby server URL. Must be https://.
# If missing, the app shows "Online play is unavailable" instead of
# silently using a hardcoded fallback.
VITE_LOBBY_SERVER_URL=https://your-lobby-server.example.com

# Optional secondary lobby URL used if the primary env var is unset.
# VITE_LOBBY_SERVER_FALLBACK_URL=

# Supabase auth (email login in web / WebView UI).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional error monitoring. When set, the Sentry SDK is dynamically loaded
# and captures uncaught errors with stack traces. Without it, errors are still
# reported to the lobby server's telemetry endpoint (structured JSON logs).
# VITE_SENTRY_DSN=

# Set to "true" to disable the built-in telemetry (client error + analytics
# event reporting to the lobby server).
# VITE_TELEMETRY_DISABLED=true

# TESTING ONLY — never enable these in a live storefront build:
# VITE_ENABLE_DEMO_BILLING=true   # re-enables fake demo purchases in prod build
# VITE_ENABLE_LOCAL_AUTH=true     # re-enables insecure base64 local auth in prod build

# ══════════════════════════════════════════════════════════════════
# Lobby server (runtime — set on the server host, e.g. Railway)
# ══════════════════════════════════════════════════════════════════

# REQUIRED. Enables production hardening (CORS enforcement, warnings).
NODE_ENV=production

# REQUIRED in production. Comma-separated allowed CORS origins.
# The server refuses to start with wildcard (*) origins in production.
LOBBY_CLIENT_ORIGINS=https://pantsonfire.app,https://www.pantsonfire.app

# STRONGLY RECOMMENDED. Durable lobby storage; without it lobby state
# is in-memory and resets on restart.
LOBBY_REDIS_URL=redis://your-redis-host:6379

# STRONGLY RECOMMENDED. Persists RevenueCat entitlements to the
# user_entitlements table (see docs/supabase-entitlements-migration.sql).
# Without these the server logs a warning and entitlements reset on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat webhook auth: Authorization: Bearer <this value>
# on POST /api/billing/revenuecat
REVENUECAT_WEBHOOK_SECRET=

# Optional JSON map RevenueCat entitlement id -> tier id
# (fibber|local_liar|suspect|host_most)
# REVENUECAT_ENTITLEMENT_TIER_JSON={"my_rc_entitlement":"host_most"}

# Optional voice chat (LiveKit).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional operational tunables.
# LOBBY_SESSION_TOKEN_TTL_MS=43200000   # session token lifetime (default 12h)
# LOBBY_DISCONNECT_GRACE_MS=60000       # grace before removing a disconnected player (default 60s)
# LOBBY_REDIS_KEY_PREFIX=pof:lobby      # Redis key namespace

# ══════════════════════════════════════════════════════════════════
# Mobile shell (Expo, optional)
# ══════════════════════════════════════════════════════════════════

# EXPO_PUBLIC_GAME_URL=https://your-web-frontend.example.com
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
