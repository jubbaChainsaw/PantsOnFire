{
  "browser": {
    "launchOptions": {
      "headless": true
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 720
      }
    }
  },
  "network": {
    "allowedOrigins": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "timeouts": {
    "navigation": 90000,
    "action": 10000
  }
}
