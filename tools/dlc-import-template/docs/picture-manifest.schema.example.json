{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Picture DLC Manifest",
  "type": "object",
  "required": ["id", "version", "label", "category", "releaseChannel", "enabled", "basePath", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "label": { "type": "string" },
    "category": { "const": "picture" },
    "releaseChannel": { "type": "string", "enum": ["base", "dlc"] },
    "enabled": { "type": "boolean" },
    "basePath": { "type": "string", "pattern": "^/assets/graphic-packs/picture/[a-z0-9-]+/images$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entryId", "main", "imposter", "mainMediaFile", "imposterMediaFile"],
        "properties": {
          "entryId": { "type": "string" },
          "groupId": { "type": "string" },
          "groupName": { "type": "string" },
          "hint": { "type": "string" },
          "main": { "type": "string" },
          "imposter": { "type": "string" },
          "mainMediaFile": { "type": "string", "pattern": "\\.png$" },
          "imposterMediaFile": { "type": "string", "pattern": "\\.png$" },
          "previewLabel": { "type": "string" },
          "adultOnly": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
